# ─────────────────────────────────────────────────────────────────────────────
# NUNCA comite o .env real — apenas este .env.example (sem segredos).
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados (MySQL) ──
# Usado direto pelo mysql2 (sem ORM). No XAMPP, o padrão é root SEM senha:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=checkout

# SSL/TLS do banco (provedores gerenciados como a Aiven EXIGEM). Cole aqui o
# conteúdo do ca.pem (certificado CA do provedor). Em branco = conecta sem SSL
# (ok para XAMPP/local). Na Vercel, cole o ca.pem inteiro nesta variável.
DB_CA_CERT=

# ── Segredos da aplicação ──
# Assina/deriva os tokens de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="troque-por-48-bytes-aleatorios"

# Chave-mestra que CRIPTOGRAFA as credenciais de integração (Shopify) no banco.
# DEVE ter 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="troque-por-32-bytes-em-base64"

# Tempo de vida da sessão em segundos (7 dias)
SESSION_TTL_SECONDS="604800"

# Conta HylexPay DA PLATAFORMA — a que recebe as taxas e os planos dos
# lojistas (não confundir com a HylexPay de cada loja, que recebe as vendas).
#
# É o ÚNICO lugar onde ela existe: não há campo no painel de admin, de
# propósito. Esta credencial aponta para a conta onde cai o dinheiro da
# plataforma, então trocá-la tem que exigir acesso a este ambiente — e não
# apenas a um login de admin, que pode ser invadido.
#
# Sem ela o saldo das taxas continua acumulando; só não dá para gerar o Pix.
HYLEXPAY_PLATFORM_PUBLIC_KEY=
HYLEXPAY_PLATFORM_SECRET_KEY=

# Protege as rotas de relógio (/api/cron/recovery e /api/cron/reconcile).
# A Vercel manda "Authorization: Bearer <CRON_SECRET>" nos cron jobs do
# vercel.json; um pinger externo pode usar ?secret=<CRON_SECRET>.
# EM BRANCO = rota ABERTA a qualquer um. Defina em produção. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=


NODE_ENV="development"

# ── Shopify ──
# As credenciais da Shopify são POR LOJA e ficam no painel (criptografadas no
# banco) — NÃO vão aqui. Cada lojista informa:
#  - MANUAL: Admin API token + webhook secret, OU
#  - OAUTH (1 clique): a API key + API secret do PRÓPRIO app (Shopify Partners).
#    Instala pelo App URL: <sua-url>/api/postback/shopify/installapp
#    e o Redirect: <sua-url>/api/postback/shopify/callback

# Domínio próprio: alvo do CNAME que os lojistas apontam.
# Na Vercel, o padrão é cname.vercel-dns.com (não precisa mudar).
PLATFORM_DOMAIN_TARGET=cname.vercel-dns.com

# De onde os E-MAILS carregam os ícones (public/email/*.png). No e-mail não
# existe caminho relativo, então a URL tem que ser absoluta.
# A loja com domínio próprio VERIFICADO usa o dela e ignora isto. Para as
# demais, a Vercel já expõe VERCEL_PROJECT_PRODUCTION_URL sozinha — só preencha
# aqui se quiser forçar outro endereço (ex.: https://voxcheckout.cloud).
EMAIL_ASSET_BASE=

# ── Vercel Domains API (registro AUTOMÁTICO dos domínios dos lojistas) ──
# Sem isso, um domínio apontado à Vercel dá "DEPLOYMENT_NOT_FOUND" (precisa ser
# adicionado manualmente no dashboard). Com isso, o painel registra sozinho.
#  - VERCEL_TOKEN: crie em Vercel → Account Settings → Tokens.
#  - VERCEL_PROJECT_ID: Project → Settings → General (Project ID).
#  - VERCEL_TEAM_ID: só se o projeto está num Time (Team Settings → General).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ── Transfyre (pagamentos Pix) ──
# A chave de API e o signing secret do webhook NÃO ficam aqui: cada loja os
# configura no PAINEL ADMIN (/admin) e eles são criptografados com a
# ENCRYPTION_KEY e guardados no banco (igual à Shopify).
# Só a URL base é configurável por ambiente (opcional). Padrão: produção.
# TRANSFYRE_API_URL=https://api.transfyre.com/v1
